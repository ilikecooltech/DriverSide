{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/((?!api/).*)",
      "has": [{ "type": "host", "value": "driverside.vercel.app" }],
      "destination": "https://www.driverside.ai/$1",
      "permanent": true
    }
  ]
}
