# ── Server-side only (Vercel env vars / local .env, NEVER client code) ──
# MarketCheck. Per CLAUDE.md: confirm the Aug 9 exposed key was rotated
# before setting any key here. Without it, /api/market serves the real
# Aug 8, 2026 snapshot for the CR-V and honest no-data for other vehicles.
MARKETCHECK_API_KEY=

# Local API server port (Vite dev proxies /api here; Vercel ignores this)
PORT=8787

# ── Client-side (VITE_ prefix = bundled into the app; these are public
#    by design — anon key + RLS for Supabase, write-only key for PostHog) ──
# Supabase: project URL + anon key (Settings -> API). Empty = simulated auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PostHog: project API key (Settings -> Project). Empty = analytics off.
VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com
