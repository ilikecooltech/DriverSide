# ── Server-side only (Vercel env vars / local .env, NEVER client code) ──
# MarketCheck. Per CLAUDE.md: confirm the Aug 9 exposed key was rotated
# before setting any key here. Without it, /api/market serves the real
# Aug 8, 2026 snapshot for the CR-V and honest no-data for other vehicles.
MARKETCHECK_API_KEY=

# Demo sign-in (server-side only). One phone number that signs in with
# one fixed 6 to 8-digit code and no SMS, so the signed-in experience can be
# shown before an SMS provider is switched on. Leave empty to disable.
# The account is tagged demo:true in analytics.
DEMO_PHONE=
DEMO_CODE=
DEMO_NAME=

# Optional, server-side. Free key from https://www.eia.gov/opendata/register.php for the
# weekly gas price by ZIP. Without it the public DEMO_KEY is used (rate-limited,
# fine behind the 6-hour cache).
EIA_API_KEY=

# Local API server port (Vite dev proxies /api here; Vercel ignores this)
PORT=8787

# ── Client-side (VITE_ prefix = bundled into the app; these are public
#    by design — anon key + RLS for Supabase, write-only key for PostHog) ──
# Supabase: project URL + anon key (Settings -> API). Empty = simulated auth.
# Sign-in is a one-time code to a phone number or an email. Email OTP works
# as soon as the project exists; phone OTP needs an SMS provider configured
# in Supabase -> Auth -> Providers (see DEPLOY.md step 2).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Text-message sign-in. Off until an SMS provider is configured in
# Supabase -> Auth -> Phone; the form asks for email only. "true" brings
# back "phone or email" with no code change. The demo number works either way.
VITE_ENABLE_SMS_LOGIN=

# Social sign-in (Google/Apple) is deferred until certification and paid
# subscriptions. Unset/false hides the buttons; "true" brings them back with
# no code change (the provider still has to be enabled in Supabase).
VITE_ENABLE_SOCIAL_LOGIN=

# PostHog: public project token (phc_..., Settings -> Project). Empty =
# analytics off. Crash reports (unhandled errors) ride on the same key.
VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Ask (the in-app question box). Server only, never VITE_. Empty = Ask is
# off and its button doesn't show. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# Optional model overrides. Defaults: claude-haiku-5-5 for general
# questions, claude-sonnet-5-5 at the dealer or on a quote.
ASK_MODEL_FAST=
ASK_MODEL_DEEP=
